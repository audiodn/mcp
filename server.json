{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "net.audiodelivery/mcp",
  "title": "Audio Delivery Network",
  "description": "AI-manageable audio CDN: upload, transcode, stream & deliver audio outputs, plus grounded docs.",
  "websiteUrl": "https://audiodeliverynetwork.com/for-ai-agents/",
  "version": "0.5.0",
  "repository": {
    "url": "https://github.com/audiodn/mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://audiodeliverynetwork.com/logo.png",
      "mimeType": "image/png"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@audiodn/mcp",
      "version": "0.5.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ADN_API_KEY",
          "description": "AudioDN server-side API Access key (adn_...). Optional — knowledge/doc tools work without it; live API tools activate when set. Prefer the hosted OAuth endpoint for account login.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "ADN_API_BASE_URL",
          "description": "Override the AudioDN API base URL. Defaults to https://api.audiodelivery.net.",
          "isRequired": false
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.audiodelivery.net/mcp"
    }
  ],
  "_meta": {
    "io.modelcontextprotocol.registry/publisher-provided": {
      "com.github": {
        "serverDisplayName": "AudioDN",
        "tags": [
          "audio",
          "audio-hosting",
          "audio-cdn",
          "transcoding",
          "sound",
          "streaming",
          "waveform",
          "podcast",
          "media",
          "upload",
          "music"
        ],
        "categories": [
          "Media",
          "Audio",
          "Infrastructure",
          "Developer Tools"
        ]
      }
    }
  }
}
